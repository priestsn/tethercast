# Gli script e le unit systemd DEVONO restare con fine riga LF.
# Con CRLF non partono su Linux: "bad interpreter: No such file or directory".
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.md   text eol=lf
LICENSE text eol=lf
*.js   text eol=lf
*.html text eol=lf
